# ==========================================
# Root .gitignore for SIH 2026 Repositories
# ==========================================

# Node / Frontend
node_modules/
dist/
dist-electron/
build/
out/
.next/
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/

# Databases & Caches
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
redis.dump
meili_data/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
secrets/

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker Overrides
docker-compose.override.yml

# Temporary / OS / Cache Files
tmp/
temp/
.tmp/
uploads/
.cache/
.parcel-cache/

# ============================================================
# Samdarshi SIH 2026 — Environment Configuration
# Copy this file to .env and fill in real values before deploy.
# ============================================================

# ---- Database ----
# SQLite (prototype) or PostgreSQL for production.
# Override to postgresql://user:pass@host:5432/samdarshi
DATABASE_URL=sqlite:///./samdarshi.db

# ---- Ports ----
# Ports inside the container (host ports mapped in docker-compose.yml)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- AI Toggle ----
# Set to "true" to use real AI (requires Ollama / OpenAI endpoint).
# Set to "false" (default) for deterministic keyword-matched responses.
USE_REAL_AI=false

# ---- Security ----
# Generate a strong key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-in-production-use-secrets-token-hex

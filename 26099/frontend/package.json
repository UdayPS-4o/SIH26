{
  "name": "nummf-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "export:masters": "esbuild scripts/export-masters.ts --bundle --platform=node --format=esm --outfile=scripts/.masters.mjs --log-level=warning && node scripts/.masters.mjs",
    "check:corpus": "esbuild scripts/check-corpus.ts --bundle --platform=node --format=esm --outfile=scripts/.check.mjs --log-level=warning && node scripts/.check.mjs",
    "export:model": "esbuild scripts/export-model-data.ts --bundle --platform=node --format=esm --outfile=scripts/.export.mjs --log-level=warning && node scripts/.export.mjs",
    "check:truth": "esbuild scripts/check-truth.ts --bundle --platform=node --format=esm --outfile=scripts/.truth.mjs --log-level=warning && node scripts/.truth.mjs",
    "demo:numbers": "esbuild scripts/demo-numbers.ts --bundle --platform=node --format=esm --outfile=scripts/.demo.mjs --log-level=warning && node scripts/.demo.mjs",
    "check:masters": "esbuild scripts/check-masters.ts --bundle --platform=node --format=esm --outfile=scripts/.masters-check.mjs --log-level=warning && node scripts/.masters-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.8.0",
    "axios": "^1.6.0",
    "framer-motion": "^10.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  }
}
